
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = 'aadityadocker16/cloudops-pipeline'
        K8S_DEPLOYMENT = 'cloudops-pipeline'
        K8S_SERVICE = 'cloudops-pipeline-service'
    }

    triggers {
        // Check the GitHub repository for changes every 5 minutes.
        pollSCM('H/5 * * * *')

        // Schedule a release check at midnight on the 25th.
        cron('0 0 25 * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Validate Files') {
            steps {
                sh '''
                    set -eu
                    test -f Dockerfile
                    test -f app/index.html
                    test -f k8s/deployment.yaml
                    test -f k8s/service.yaml
                    test -f jenkins/Jenkinsfile
                    echo "All required files are present."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -t "$DOCKER_IMAGE:$BUILD_NUMBER" \
                      -t "$DOCKER_IMAGE:latest" .
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                        docker push "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }

        stage('Check Release Day') {
            steps {
                script {
                    env.RELEASE_DAY = sh(
                        script: 'date +%d',
                        returnStdout: true
                    ).trim()

                    if (env.RELEASE_DAY == '25') {
                        echo 'Release day confirmed: the 25th.'
                    } else {
                        echo "Today is day ${env.RELEASE_DAY}; production deployment is held until the 25th."
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                expression {
                    env.RELEASE_DAY == '25'
                }
            }
            steps {
                sh '''
                    set -eu

                    echo "Checking Kubernetes deployment..."
                    kubectl get deployment "$K8S_DEPLOYMENT"

                    CONTAINER_NAME=$(kubectl get deployment "$K8S_DEPLOYMENT" \
                      -o jsonpath='{.spec.template.spec.containers[0].name}')

                    test -n "$CONTAINER_NAME"

                    echo "Updating image to $DOCKER_IMAGE:$BUILD_NUMBER"

                    kubectl set image \
                      deployment/"$K8S_DEPLOYMENT" \
                      "$CONTAINER_NAME=$DOCKER_IMAGE:$BUILD_NUMBER"

                    kubectl rollout status \
                      deployment/"$K8S_DEPLOYMENT" \
                      --timeout=120s

                    kubectl get deployments
                    kubectl get pods
                    kubectl get services
                '''
            }
        }
    }

    post {
        success {
            echo 'CloudOps pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Review Console Output for the failing stage.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
