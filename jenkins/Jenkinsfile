
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        APP_NAME = 'cloudops-pipeline'
        DOCKER_IMAGE = 'aadityadocker16/cloudops-pipeline'
        DOCKER_TAG = "${BUILD_NUMBER}"
        K8S_DEPLOYMENT = 'cloudops-pipeline'
        K8S_SERVICE = 'cloudops-pipeline-service'
    }

    triggers {
        // Scheduled pipeline run on the 25th of each month.
        cron('H H 25 * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    echo "Source code checked out successfully"
                    echo "Build number: $BUILD_NUMBER"
                '''
            }
        }

        stage('Validate Files') {
            steps {
                sh '''
                    set -eu
                    test -f Dockerfile
                    test -f app/index.html
                    test -f k8s/deployment.yaml
                    test -f k8s/service.yaml
                    echo "Required project files found."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      -t "$DOCKER_IMAGE:$DOCKER_TAG" \
                      -t "$DOCKER_IMAGE:latest" .
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        printf '%s' "$DOCKERHUB_TOKEN" |
                          docker login \
                            --username "$DOCKERHUB_USER" \
                            --password-stdin

                        docker push "$DOCKER_IMAGE:$DOCKER_TAG"
                        docker push "$DOCKER_IMAGE:latest"

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    kubectl set image \
                      deployment/"$K8S_DEPLOYMENT" \
                      app="$DOCKER_IMAGE:$DOCKER_TAG"

                    kubectl rollout status \
                      deployment/"$K8S_DEPLOYMENT" \
                      --timeout=120s

                    kubectl get deployments
                    kubectl get pods
                    kubectl get services
                '''
            }
        }
    }

    post {
        success {
            echo 'CloudOps pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review Console Output for the failing stage.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
